# VoyagerOS64 0.0.5 Doxygen release configuration.
#
# This file is intentionally standalone. The older repository-wide Doxygen
# configuration predates the 0.0.5 stabilization work and contains options that
# are obsolete in Doxygen 1.9.4. Keeping the release configuration independent
# avoids inheriting those warnings while leaving the historical config intact.

DOXYFILE_ENCODING = UTF-8
PROJECT_NAME = VoyagerOS64
PROJECT_NUMBER = 0.0.5
PROJECT_BRIEF = "VoyagerOS64 0.0.5 kernel architecture and API reference"
OUTPUT_LANGUAGE = English

OPTIMIZE_OUTPUT_FOR_C = YES
EXTRACT_ALL = YES
EXTRACT_STATIC = YES
WARNINGS = YES
WARN_IF_DOC_ERROR = YES
WARN_NO_PARAMDOC = NO

# ./src already contains ./src/include recursively. Listing both would parse
# every header twice and can produce duplicate @param documentation warnings.
INPUT = ./src
FILE_PATTERNS = *.c *.h *.md *.cpp *.hpp
RECURSIVE = YES

# Match GNUmakefile's retired implementation set and hide the corresponding
# archaeological headers from the 0.0.5 release API reference. Historical
# context remains documented by voyager_docs.h.
EXCLUDE = \
    ./src/heap.c \
    ./src/bucket.c \
    ./src/pebble.c \
    ./src/frameallocator.c \
    ./src/vmm.c \
    ./src/streams.c \
    ./src/liballoc.c \
    ./src/memUtils.c \
    ./src/mm/liballoc_glue.c \
    ./src/alloc.cpp \
    ./src/lock.cpp \
    ./src/lock_atm_c.cpp \
    ./src/include/heap.h \
    ./src/include/bitmap.h \
    ./src/include/pebble.h \
    ./src/include/liballoc.h \
    ./src/include/lock.hpp \
    ./src/include/memUtils.h \
    ./src/include/paging/frameallocator.h \
    ./src/include/paging/vmm.h

SOURCE_BROWSER = YES
INLINE_SOURCES = NO

# Generate a browsable reference as well as LaTeX suitable for a PDF build.
# Both outputs intentionally use the low-glare Voyager dark theme under
# docs/theme. Generated output remains disposable; edit the theme sources, not
# html/ or latex/ directly.
GENERATE_HTML = YES
HTML_OUTPUT = html
GENERATE_TREEVIEW = YES
SEARCHENGINE = YES
HTML_EXTRA_STYLESHEET = docs/theme/voyager-dark.css

GENERATE_LATEX = YES
LATEX_OUTPUT = latex
USE_PDFLATEX = YES
LATEX_BATCHMODE = YES
PDF_HYPERLINKS = YES
LATEX_EXTRA_STYLESHEET = docs/theme/voyager-dark.sty

# Graphviz is already part of the established Voyager documentation workflow.
HAVE_DOT = YES
DOT_NUM_THREADS = 0
INCLUDE_GRAPH = YES
INCLUDED_BY_GRAPH = YES
CALL_GRAPH = YES
CALLER_GRAPH = YES
DIRECTORY_GRAPH = YES
DOT_GRAPH_MAX_NODES = 100
GENERATE_LEGEND = YES
