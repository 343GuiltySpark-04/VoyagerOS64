% VoyagerOS64 dark PDF theme for Doxygen-generated LaTeX.
% Lucyna palette edition; loaded through LATEX_EXTRA_STYLESHEET in
% Doxygen-0.0.5.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{voyager-dark}[2026/09/10 VoyagerOS64 Lucyna Doxygen PDF theme]

\RequirePackage{xcolor}
\RequirePackage{colortbl}

% Exact accent palette selected for the Lucyna visual direction.
\definecolor{LucynaBlack}{HTML}{000000}
\definecolor{LucynaMagenta}{HTML}{C5003C}
\definecolor{LucynaCrimson}{HTML}{880425}
\definecolor{LucynaYellow}{HTML}{F3E600}
\definecolor{LucynaCyan}{HTML}{55EAD4}

% Derived neutrals for long-form technical reading.
\definecolor{LucynaPanel}{HTML}{0B0B0E}
\definecolor{LucynaPanelTwo}{HTML}{121217}
\definecolor{LucynaPanelThree}{HTML}{18181F}
\definecolor{LucynaBorder}{HTML}{2A2A32}
\definecolor{LucynaFg}{HTML}{D8DEE3}
\definecolor{LucynaFgBright}{HTML}{F2F5F7}
\definecolor{LucynaMuted}{HTML}{9299A1}
\definecolor{LucynaCode}{HTML}{08080B}

% Doxygen source-listing syntax colors.
\definecolor{comment}{HTML}{9299A1}
\definecolor{keyword}{HTML}{C5003C}
\definecolor{keywordtype}{HTML}{55EAD4}
\definecolor{keywordflow}{HTML}{F3E600}
\definecolor{preprocessor}{HTML}{F3E600}
\definecolor{stringliteral}{HTML}{55EAD4}
\definecolor{charliteral}{HTML}{55EAD4}

% Whole-document dark canvas.
\pagecolor{LucynaBlack}
\color{LucynaFg}
\arrayrulecolor{LucynaBorder}

% Modern on-screen reading defaults. Doxygen's code/verbatim environments keep
% their own monospaced face.
\renewcommand{\familydefault}{\sfdefault}

% Doxygen loads hyperref before this stylesheet, so set the final palette after
% the document starts.
\AtBeginDocument{%
  \pagecolor{LucynaBlack}%
  \color{LucynaFg}%
  \arrayrulecolor{LucynaBorder}%
  \hypersetup{%
    colorlinks=true,%
    linkcolor=LucynaMagenta,%
    urlcolor=LucynaCyan,%
    citecolor=LucynaYellow,%
    filecolor=LucynaCyan,%
    menucolor=LucynaMagenta,%
    pdfborder={0 0 0}%
  }%
}

% Section hierarchy: cyan for navigation/readability, magenta for the next
% visual tier, with yellow reserved for smaller accents and warnings.
\makeatletter
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-3.5ex \@plus -1ex \@minus -.2ex}%
  {2.3ex \@plus .2ex}%
  {\normalfont\Large\bfseries\color{LucynaCyan}}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-3.25ex\@plus -1ex \@minus -.2ex}%
  {1.5ex \@plus .2ex}%
  {\normalfont\large\bfseries\color{LucynaMagenta}}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-3.25ex\@plus -1ex \@minus -.2ex}%
  {1.5ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries\color{LucynaYellow}}}
\makeatother

\setlength{\fboxsep}{5pt}
\setlength{\fboxrule}{0.4pt}

% Header/footer rules otherwise disappear into a black page.
\AtBeginDocument{%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\footrulewidth}{0.2pt}%
}

% Common Doxygen table/header colors.
\definecolor{tableheadbgcolor}{HTML}{880425}
\definecolor{tableheadfgcolor}{HTML}{F2F5F7}
\definecolor{headbgcolor}{HTML}{121217}
\definecolor{headfgcolor}{HTML}{55EAD4}

% Additional color names used by various Doxygen LaTeX templates/releases.
\definecolor{lightgray}{HTML}{121217}
\definecolor{darkgray}{HTML}{9299A1}
\definecolor{DoxyCode}{HTML}{08080B}
\definecolor{DoxyVerb}{HTML}{D8DEE3}
\definecolor{DoxyParamCaption}{HTML}{F3E600}

% Keep framed/generated material dark and visible.
\fboxrule=0.4pt
